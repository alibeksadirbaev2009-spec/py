# loop sikkls interatsiya object - (), [], or str
# i - itm
# 1 

a = [1, 2, 3, 4, 5, 6,  7]
for i in a:
    print(i + 10)


# 2 
for i in range(1, 11):
    print(i + 10)

# 3
d = ["nukus", "qanliko'l", "moynaq"]
for i, v in enumerate(d):
    print(i, v)


a = [1, 2, 3, 4, 6, 5, 8, 4]
for i in a:
    print(i + 10)

a = [1, 2, 3, 4, 2, 6, 4, 8, 7]
for i in a:
    print(i**2) #kvadrat

b = [ 1, -2, 4, -5, -6]
for i in b:
    if i > 0:
        print(i)

k = [ 1, -2, 4, -5, -6]

o, t = 0, 0

for i in k:
    if i > 0:
        o += 1
    else:
        t += 1
    
print(o)
print(t)