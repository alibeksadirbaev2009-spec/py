# String Formating 
a = "Hello World"

#  Methods - metodlari
print(a.upper())  # U'llken ha'riplerge almastiriw
print(a.lower()) # Kishi ha'riplerge almastiriw ASCII
print(a.casefold()) # Kishi ha'riplerge almastiriw UNICOSE

print(a.capitalize()) # Tek birinshi basindagi ha'rip u'lken boladi qalagan ha'mmesi kishi
print(a.title()) # probelden keyingi ha'mme ha'rip u'lken boladi
print(a.replace("l", "k")) # bir ha'riptin ornina basqa ha'rip kiritiw

# Slicing
print(a[2])
print(a[2:9])
print(a[0 : 9 : 2])
print(a[ : : -1]) # "Start.Stop.Period" 0 = joq shegarasiz

# formating 
name = "John"
age = 29

# 1
print("My name is "+name+ " I am 29")

# 2
pattern = "My name is %s, I am %d"
print(pattern %(name, age))

# 3
pattern2 = "My name is {0}, I am {1}"
print(pattern2.format(name, age))
pattern3 = "My name is {name}, I am {age}"
print(pattern3.format(name = name, age = age))

# 4 f - string
print(f"My name is {name}, I am {age}")

#  Tapsirma

first_name = "Ran"
last_name = "Takahashi"
born = 2003
current_year = 2026

print(f"My name is {first_name} {last_name}, I am {current_year - born} years old")

