# match - case
a = 9

match a:  # exception 
    case 1: # pattern
        print("Bir")
    case 2:  # pattern
        print("eki")
    case 3:  # pattern
        print("ush")
    case _: # wildcard
        print("ya1q")

    
a = int(input("a = "))
print("Qaysi o'lshemge o'xgertemis ->")
b = input("O'lshem")
match b:
    case "km":
        result = round(a / 1000, 1)
        print(f"Juwap: {result}km")
    case "dm":
        result = (a * 10)
        print(f"Juwap: {result}dm")
    case "sm":
        result = (a * 100)
        print(f"Juwap: {result}sm")
    case "mm":
        result = (a * 1000)
        print(f"Juwap: {result}mm")
    case _:
        "Uyqla"

