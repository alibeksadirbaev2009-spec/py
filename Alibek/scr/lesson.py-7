# 1 
k = int(input("k = "))
match k:
    case 1:
        print("Monday")
    case 2:
        print("Tuesday")
    case 3:
        print("Wednesday")
    case 4:
        print("Thoursday")
    case 5:
        print("Friday")
    case 6:
        print("Saturday")
    case 7:
        print("Sunday")
    case _:
        print("Nothing")


a = [4, 5, 7, 3]
match a:
    case [x, 6]:
        print("e")
    case [9, y]:
        print("aa")
    case [x, y]:
        print(x + y)
    case [x, y, *z]:
        print(x + y + sum(z))