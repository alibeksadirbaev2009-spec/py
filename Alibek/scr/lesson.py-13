# 2.1

def perimetr(a: int, b: int, c: int) -> int:
    if not (
        a + b < c
        and a + c < b
        and b + c < a
    ):
        raise ValueError("U'shmu'yish bola almaydi")
    
    return a + b + c

print(perimetr(4, 2, 2))