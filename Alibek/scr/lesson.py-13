# # *args, **kwargs

# # *args - tuple
def my_func(*args) -> int:
    t = 0
    for i in args:
        t += 1
    return t

print(my_func(5, 4, 3, 3, 1, 55, 3, 3333))

# kwargs - dict      imutabel mutable         h lanatin
def my_func1(**kwargs):
    return kwargs

print(my_func1(age = 6, name = "John"))

def summa(*args: int) -> int:
    t = 0
    for i in args:
        if isinstance(i, int):
            t += i
    return t
print(summa(2, 4, 55, 3))

