# instal, clc, clear
# uninstal

def count_letters(*args: str) ->dict:
    upper = 0
    lower = 0
    for text in args:
        if isinstance(text, str):
            for i in text:
                if 'A' <= i <= 'Z':
                    upper += 1
                elif 'a' <= i <= 'z':
                    lower += 1
                    
    return {'up': upper, 'low': lower}

print(count_letters('H', 's', 'd', 'W'))


# 2
def triangle(a: int, b: int, c: int) -> int:
    if not (isinstance(a, (int, float)) and
            isinstance(b, (int, float)) and  
            isinstance(c, (int, float))):
        raise TypeError("Ta'repleri int yamasa float boliwi kerek")
    
    if a <= 0 or b <= 0 or c <= 0:
        raise ValueError("Ta'repleri 0 den u'lken boliwi kerek")
    
    if not (a + b > c and a + c > b and b + c > a):
        raise ValueError("U'shmu'yish bola almaydi")
    
    perimetr = a + b + c
    print("Perimetr:", perimetr)

triangle(10, 1, 10)

