# while - loop
a = 10
i = 0 

while i < a:
    i += 1
    print(i)
else:
    print("Toqtadi")




k = int(input("k = "))
i = 0

while i < k:
    i += 1
    print(i)

t = 0

while True:
    l = int(input("l = "))
    if l == 0:
        break
    t += l
    
print(t)
n = int(input("n = "))
t = 1
c = 1
while t <= n:
    c *= t
    t += 1

print(c)
   

