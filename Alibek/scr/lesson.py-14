# 1

def search(file: str) -> bool:
    try:
        with open(file, 'r'):
            return True
    except FileNotFoundError:
        return False

file = "example.txt"
print(search(file))  

# 1.1

def search1(file: str) -> bool:
    import os
    return os.path.exists(file) 

print(search1("example.txt"))  


# 2  copy 
def Christmas_tree(n):
   
    for i in range(n):
        print(" " * (n - i - 1) + "*" * (2 * i + 1))
    
    for i in range(2):
        print(" " * (n - 1) + "*")

Christmas_tree(5)
# /n 


# 2.1

with open("example.txt", 'w') as file:
    picture = []
    n = 10
    for i in range(1, n*2, 2):
        row = int((n*2-i)/2)* " "+i*"*"
        picture.append(row)
    file.write("\n".join(picture))