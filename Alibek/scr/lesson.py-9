#  continue - dawam ettiriw
a = [5, 6, 4, 3, 4, 7, 8, 0]

for i in a:
    if i % 2 != 0:
        continue

    print(i)

# break - toqtatiw
for i in a:
    if i == 7:
        break

    print(i)

k = [5, 9, 22, 3, 4]
t = 0

for i in a:
    t += i

print(t) 
